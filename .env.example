# ── PixMath Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in the values.

# ── General ────────────────────────────────────────────────────────────────
PIXMATH_ENV=development
PIXMATH_LOG_LEVEL=DEBUG
PIXMATH_SECRET_KEY=change-me-in-production

# ── API Gateway ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:5173"]
API_MAX_UPLOAD_MB=50

# ── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://pixmath:pixmath@localhost:5672/
RABBITMQ_FORWARD_QUEUE=forward_jobs
RABBITMQ_REVERSE_QUEUE=reverse_jobs
RABBITMQ_DLX_EXCHANGE=pixmath.dlx

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PUBSUB_CHANNEL=pixmath:events

# ── PostgreSQL (Supabase locally) ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pixmath:pixmath@localhost:5432/pixmath

# ── MinIO / S3 (Object Storage) ───────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pixmath-renders

# ── Forward Worker ─────────────────────────────────────────────────────────
FORWARD_AST_MAX_DEPTH=32
FORWARD_AST_MAX_NODES=2000
FORWARD_RENDER_TIMEOUT_SEC=15
FORWARD_MAX_RESOLUTION=4096

# ── Reverse Worker ─────────────────────────────────────────────────────────
REVERSE_SIREN_OMEGA0=30.0
REVERSE_SIREN_HIDDEN_LAYERS=3
REVERSE_SIREN_HIDDEN_FEATURES=256
REVERSE_SIREN_EPOCHS=2000
REVERSE_SIREN_LR=0.0001
REVERSE_PYSR_POPULATIONS=40
REVERSE_PYSR_NITERATIONS=100
REVERSE_PYSR_MAXSIZE=30
REVERSE_LOSS_LAMBDA=0.84
