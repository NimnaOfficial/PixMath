# Set default behavior to automatically handle line endings
* text=auto eol=lf

# Force bash shell scripts to always have LF line endings (prevents \r issues on Linux/WSL)
*.sh text eol=lf

# Force Windows batch and PowerShell scripts to have CRLF line endings
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Force code and configuration files to LF
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.proto text eol=lf
*.fbs text eol=lf
*.css text eol=lf
*.html text eol=lf
Dockerfile* text eol=lf
.env* text eol=lf
